        Component {
          Type          CScript
          Name          "P_h,a = prom. 1 ciclo de v i"
          Show          on
          Position      [450, 170]
          Direction     up
          Flipped       off
          LabelPosition south
          Parameter {
            Variable      "DialogGeometry"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "NumInputs"
            Value         "[2]"
            Show          off
          }
          Parameter {
            Variable      "NumOutputs"
            Value         "[1]"
            Show          off
          }
          Parameter {
            Variable      "NumContStates"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "NumDiscStates"
            Value         "202"
            Show          off
          }
          Parameter {
            Variable      "NumZCSignals"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "DirectFeedthrough"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "Ts"
            Value         "Ts_lr"
            Show          off
          }
          Parameter {
            Variable      "TerminalBasedSampleTimes"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "Parameters"
            Value         "[f_g, Ts_lr]"
            Show          off
          }
          Parameter {
            Variable      "LangStandard"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "GnuExtensions"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "RuntimeCheck"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "HighlightLevel"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "Declarations"
            Value         "/* Potencia activa de cabecera: promedio movil de v"
"*i sobre un ciclo de 50 Hz.\n"
"   Con Ts_lr = 1 ms son 20 muestras: anula exacto el termino de 100 Hz.      "
"*/\n"
"/* Parametros: [f_g, Ts_lr]   Entradas: v_h, i_h   Estados: buffer, suma, ind"
"ice */\n"
"#define NCALC ((int)(1.0 / (ParamRealData(0,0) * ParamRealData(0,1)) + 0.5))"
"\n"
"#define NPROM (NCALC > 200 ? 200 : (NCALC < 1 ? 1 : NCALC))\n"
"#define SUMA  DiscState(200)\n"
"#define IDX   DiscState(201)\n"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         "{ int i; for (i = 0; i < 202; i++) DiscState(i) = 0"
".0; }"
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "OutputSignal(0,0) = SUMA / NPROM;"
            Show          off
          }
          Parameter {
            Variable      "UpdateFcn"
            Value         "{\n"
"  int k = (int)IDX;\n"
"  double p = InputSignal(0,0) * InputSignal(0,1);\n"
"  SUMA += p - DiscState(k);\n"
"  DiscState(k) = p;\n"
"  k++; if (k >= NPROM) k = 0;\n"
"  IDX = k;\n"
"}\n"
            Show          off
          }
          Parameter {
            Variable      "DerivativeFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "TerminateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "StoreCustomStateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "RestoreCustomStateFcn"
            Value         ""
            Show          off
          }
        }
