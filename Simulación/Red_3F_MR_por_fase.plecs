          Direction     up
          Flipped       off
          LabelPosition south
          Parameter {
            Variable      "DialogGeometry"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "NumInputs"
            Value         "[5]"
            Show          off
          }
          Parameter {
            Variable      "NumOutputs"
            Value         "[5]"
            Show          off
          }
          Parameter {
            Variable      "NumContStates"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "NumDiscStates"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "NumZCSignals"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "DirectFeedthrough"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "Ts"
            Value         "Ts_lr"
            Show          off
          }
          Parameter {
            Variable      "TerminalBasedSampleTimes"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "Parameters"
            Value         "[1, 1, Kp_lr, Ki_lr, Ts_lr, t_lr_on, Lazo_ON, beta_"
"b1]"
            Show          off
          }
          Parameter {
            Variable      "LangStandard"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "GnuExtensions"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "RuntimeCheck"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "HighlightLevel"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "Declarations"
            Value         "#define MIN(a,b) ((a) < (b) ? (a) : (b))\n"
"/* Parametros: [fase (0,1,2), N, Kp_lr, Ki_lr, Ts_lr, t_lr_on, Lazo_ON, beta_"
"1..beta_N] */\n"
"#define FASE  ((int)ParamRealData(0,0))\n"
"#define NMR   ((int)ParamRealData(0,1))\n"
"#define KP    ParamRealData(0,2)\n"
"#define KI    ParamRealData(0,3)\n"
"#define TS    ParamRealData(0,4)\n"
"#define TON   ParamRealData(0,5)\n"
"#define LON   ParamRealData(0,6)\n"
"#define BETA(i) ParamRealData(0,7+(i))\n"
"/* Entradas: P_h,a  P_h,b  P_h,c  F_up(1..N)  F_dn(1..N) */\n"
"#define PH(i)  InputSignal(0,(i))\n"
"#define FUP(i) InputSignal(0,3+(i))\n"
"#define FDN(i) InputSignal(0,3+NMR+(i))\n"
"/* Salidas: dP_k(1..N)  e_phi  dP_phi  lambda_phi  u_phi */\n"
"#define X      DiscState(0)\n"
"#define ACTIVO (LON > 0.5 && CurrentTime >= TON)\n"
"\n"
"/* water-filling: reparte d >= 0 entre n MR con cotas f[i] y pesos f[i]/(1+b["
"i]).\n"
"   Devuelve lambda (precio de la fase). C puro: no usa macros de PLECS.      "
"  */\n"
"static double llenar(double d, int n, const double *f, const double *b, doubl"
"e *out)\n"
"{\n"
"  int i, it;\n"
"  double lo = 0.0, hi = 0.0, mid, s;\n"
"  for (i = 0; i < n; i++) if (1.0 + b[i] > hi) hi = 1.0 + b[i];\n"
"  for (it = 0; it < 60; it++) {\n"
"    mid = 0.5 * (lo + hi); s = 0.0;\n"
"    for (i = 0; i < n; i++) s += MIN(f[i], mid * f[i] / (1.0 + b[i]));\n"
"    if (s < d) lo = mid; else hi = mid;\n"
"  }\n"
"  for (i = 0; i < n; i++) out[i] = MIN(f[i], hi * f[i] / (1.0 + b[i]));\n"
"  return hi;\n"
"}\n"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         "X = 0.0;"
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "{\n"
"  int i, n = NMR;\n"
"  double e, fu = 0.0, fd = 0.0, v, dp, lam = 0.0, u = 0.0;\n"
"  double rep[64], vup[64], vdn[64], b[64];\n"
"  if (n > 64) n = 64;\n"
"  e = PH(FASE) - (PH(0) + PH(1) + PH(2)) / 3.0;\n"
"  for (i = 0; i < n; i++) {\n"
"    vup[i] = FUP(i); vdn[i] = FDN(i); b[i] = BETA(i); rep[i] = 0.0;\n"
"    fu += vup[i]; fd += vdn[i];\n"
"  }\n"
"  v  = ACTIVO ? KP * e + X : 0.0;\n"
"  dp = v; if (dp > fu) dp = fu; if (dp < -fd) dp = -fd;\n"
"  if (dp > 0.0 && fu > 0.0)      { lam =  llenar( dp, n, vup, b, rep); u = dp"
" / fu; }\n"
"  else if (dp < 0.0 && fd > 0.0) { lam = -llenar(-dp, n, vdn, b, rep); u = dp"
" / fd; for (i = 0; i < n; i++) rep[i] = -rep[i]; }\n"
"  for (i = 0; i < n; i++) OutputSignal(0,i) = rep[i];\n"
"  OutputSignal(0,n)   = e;\n"
"  OutputSignal(0,n+1) = dp;\n"
"  OutputSignal(0,n+2) = lam;\n"
"  OutputSignal(0,n+3) = u;\n"
"}\n"
            Show          off
          }
          Parameter {
            Variable      "UpdateFcn"
            Value         "{\n"
"  int i, n = NMR;\n"
"  double e, fu = 0.0, fd = 0.0;\n"
"  if (!ACTIVO) { X = 0.0; }\n"
"  else {\n"
"    e = PH(FASE) - (PH(0) + PH(1) + PH(2)) / 3.0;\n"
"    for (i = 0; i < n; i++) { fu += FUP(i); fd += FDN(i); }\n"
"    X += KI * TS * e;                       /* integrador con anti-windup por"
" recorte */\n"
"    if (X > fu) X = fu;\n"
"    if (X < -fd) X = -fd;\n"
"  }\n"
"}\n"
            Show          off
          }
          Parameter {
            Variable      "DerivativeFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "TerminateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "StoreCustomStateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "RestoreCustomStateFcn"
            Value         ""
            Show          off
          }
        }
