            Component {
              Type          CScript
              Name          "Envolvente F_k"
              Show          on
              Position      [1490, 690]
              Direction     up
              Flipped       off
              LabelPosition south
              Parameter {
                Variable      "DialogGeometry"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "NumInputs"
                Value         "[4]"
                Show          off
              }
              Parameter {
                Variable      "NumOutputs"
                Value         "[2]"
                Show          off
              }
              Parameter {
                Variable      "NumContStates"
                Value         "0"
                Show          off
              }
              Parameter {
                Variable      "NumDiscStates"
                Value         "2"
                Show          off
              }
              Parameter {
                Variable      "NumZCSignals"
                Value         "0"
                Show          off
              }
              Parameter {
                Variable      "DirectFeedthrough"
                Value         "0"
                Show          off
              }
              Parameter {
                Variable      "Ts"
                Value         "Ts_lr"
                Show          off
              }
              Parameter {
                Variable      "TerminalBasedSampleTimes"
                Value         "1"
                Show          off
              }
              Parameter {
                Variable      "Parameters"
                Value         "[Pb_max, P_ic_max, E_bat, eta_d, eta_c, SOC_min"
", SOC_max, Theta_h]"
                Show          off
              }
              Parameter {
                Variable      "LangStandard"
                Value         "2"
                Show          off
              }
              Parameter {
                Variable      "GnuExtensions"
                Value         "1"
                Show          off
              }
              Parameter {
                Variable      "RuntimeCheck"
                Value         "2"
                Show          off
              }
              Parameter {
                Variable      "HighlightLevel"
                Value         "0"
                Show          off
              }
              Parameter {
                Variable      "Declarations"
                Value         "#define MIN(a,b) ((a) < (b) ? (a) : (b))\n"
"#define MAX(a,b) ((a) > (b) ? (a) : (b))\n"
"/* Parametros: [Pb_max, P_ic_max, E_bat, eta_d, eta_c, SOC_min, SOC_max, Thet"
"a_h] */\n"
"#define PBMAX  ParamRealData(0,0)\n"
"#define PICMAX ParamRealData(0,1)\n"
"#define EBAT   ParamRealData(0,2)\n"
"#define ETAD   ParamRealData(0,3)\n"
"#define ETAC   ParamRealData(0,4)\n"
"#define SOCMIN ParamRealData(0,5)\n"
"#define SOCMAX ParamRealData(0,6)\n"
"#define THETA  ParamRealData(0,7)\n"
"/* Entradas: SOC, P_bat (>0 descarga), P_IC (>0 importa), dP_k (>0 inyecta) *"
"/\n"
"#define SOC  InputSignal(0,0)\n"
"#define PBAT InputSignal(0,1)\n"
"#define PIC  InputSignal(0,2)\n"
"#define DPK  InputSignal(0,3)\n"
"#define FUP  DiscState(0)\n"
"#define FDN  DiscState(1)\n"
                Show          off
              }
              Parameter {
                Variable      "StartFcn"
                Value         "FUP = 0.0; FDN = 0.0;"
                Show          off
              }
              Parameter {
                Variable      "OutputFcn"
                Value         "OutputSignal(0,0) = FUP;\n"
"OutputSignal(0,1) = FDN;"
                Show          off
              }
              Parameter {
                Variable      "UpdateFcn"
                Value         "{\n"
"  double pb_plan  = PBAT - DPK;          /* BESS sin la correccion del lazo *"
"/\n"
"  double iny_plan = -PIC - DPK;          /* inyeccion del IC en el plan    */"
"\n"
"  double pi_up = MIN(PBMAX - pb_plan, PICMAX - iny_plan);\n"
"  double pi_dn = MIN(PBMAX + pb_plan, PICMAX + iny_plan);\n"
"  double w_up  = (SOC - SOCMIN) * EBAT * ETAD;      /* Wh disponibles para in"
"yectar */\n"
"  double w_dn  = (SOCMAX - SOC) * EBAT / ETAC;      /* Wh disponibles para ab"
"sorber */\n"
"  FUP = MAX(0.0, MIN(pi_up, w_up / THETA));\n"
"  FDN = MAX(0.0, MIN(pi_dn, w_dn / THETA));\n"
"}\n"
                Show          off
              }
              Parameter {
                Variable      "DerivativeFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "TerminateFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "StoreCustomStateFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "RestoreCustomStateFcn"
                Value         ""
                Show          off
              }
            }
